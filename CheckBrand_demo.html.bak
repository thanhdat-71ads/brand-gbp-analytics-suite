                return 'Kính gửi quý khách, ' + bName + ' chân thành cảm ơn quý khách đã dùng bữa và dành tặng đánh giá ' + r.rating + ' sao. Đội ngũ đầu bếp và nhân viên phục vụ rất hân hạnh được tiếp đón quý khách!';
              }
              return 'Kính gửi quý khách, ' + bName + ' cảm ơn quý khách đã ghé thăm. Chúng tôi rất tiếc khi bữa ăn chưa làm hài lòng quý khách trọn vẹn. Kính mong quý khách gọi tới hotline ' + bHotline + ' để nhà hàng có cơ hội lắng nghe và phục vụ chu đáo hơn.';
            }
            if (r.rating != null && r.rating <= 2) {
              return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành cáo lỗi về trải nghiệm ẩm thực chưa trọn vẹn tại nhà hàng. Ban Quản lý đã chuyển phản ánh tới ' + (r.suggestedDept || 'Bếp trưởng & Quản lý sàn') + ' để rà soát quy trình chế biến và phục vụ ngay lập tức. Kính mời quý khách liên hệ hotline ' + bHotline + ' để Quản lý nhà hàng trực tiếp hỗ trợ và gửi lời tạ lỗi thấu đáo.';
            }
            return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành cảm ơn quý khách đã thưởng thức và gửi đánh giá tốt. Bếp trưởng và tập thể nhà hàng luôn nỗ lực mang đến những món ăn chuẩn vị và không gian ấm cúng nhất cho quý khách!';
          }
        },

        retail_ecommerce: {
          id: 'retail_ecommerce',
          name: 'Bán lẻ & E-commerce / Chuỗi Cửa hàng',
          defaultUnitType: 'cửa hàng',
          topics: {
            product_quality: 'Chất lượng sản phẩm / chính hãng',
            warranty_return: 'Bảo hành / đổi trả / hoàn tiền',
            shipping_delivery: 'Đóng gói / tốc độ giao hàng',
            staff_service: 'Tư vấn viên / chăm sóc khách hàng',
            price_promo: 'Giá niêm yết / áp mã khuyến mãi',
            store_facility: 'Không gian cửa hàng / trải nghiệm'
          },
          positiveMatchers: [
            {
              id: 'product_quality',
              icon: '📦',
              label: 'sản phẩm chính hãng, chất lượng chuẩn',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('product_quality')) return true;
                return matchWords(r.text, ['chính hãng', 'chất lượng', 'xịn', 'chuẩn', 'dùng tốt', 'bền', 'ưng ý', 'nguyên seal', 'mượt']);
              }
            },
            {
              id: 'staff_service',
              icon: '👥',
              label: 'nhân viên tư vấn am hiểu, nhiệt tình',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('staff_service')) return true;
                return matchWords(r.text, ['kỹ thuật', 'tư vấn', 'hướng dẫn', 'nhiệt tình', 'am hiểu', 'chu đáo', 'tận tình', 'hỗ trợ cài đặt']);
              }
            },
            {
              id: 'shipping_delivery',
              icon: '🚚',
              label: 'giao hàng hỏa tốc, đóng gói kỹ',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('shipping_delivery')) return true;
                return matchWords(r.text, ['giao hàng', 'hỏa tốc', 'nhanh', 'đóng gói', 'bóng khí', 'cẩn thận', 'nguyên vẹn', '2 giờ', 'đúng hẹn']);
              }
            }
          ],
          riskRules: [
            {
              id: 'warranty_return',
              label: 'phản ánh chính sách bảo hành hoặc đổi trả chưa thỏa đáng',
              match: (r) => matchWords(r.text, ['bảo hành', 'đổi trả', 'từ chối', 'đổi mới', 'hãng', 'bắt khách tự mang', 'thiếu trách nhiệm', 'lỗi'])
            },
            {
              id: 'shipping_delivery',
              label: 'phản ánh giao hàng trễ hẹn hoặc hư hỏng móp méo hộp',
              match: (r) => matchWords(r.text, ['giao trễ', 'chậm', 'móp méo', 'bể góc', 'vỡ', 'hư hỏng', '5 ngày', 'trễ 5 ngày'])
            },
            {
              id: 'staff_service',
              label: 'phản ánh thái độ tư vấn hoặc hỗ trợ kỹ thuật chưa tốt',
              match: (r) => matchWords(r.text, ['thái độ', 'không nhiệt tình', 'không biết', 'bỏ lơ', 'thờ ơ'])
            }
          ],
          getRoutingDept: (topics = [], text = '', bConfig) => {
            if (topics.includes('warranty_return') || matchWords(text, ['bảo hành', 'đổi trả', 'lỗi', 'hãng', 'sửa'])) {
              return 'Trung tâm Kỹ thuật & Bảo hành';
            }
            if (topics.includes('shipping_delivery') || matchWords(text, ['giao hàng', 'vận chuyển', 'móp', 'trễ', 'shipper'])) {
              return 'Bộ phận Kho vận & Giao nhận E-com';
            }
            return 'Bộ phận CSKH & Xử lý Khiếu nại';
          },
          getDraftReply: (r, bConfig) => {
            const bName = bConfig.name;
            const bHotline = bConfig.hotline || 'hotline CSKH';
            const author = r.author || '';
            const hasText = (r.text || '').trim().length > 0;
            const sentiment = r.analysis?.sentiment || 'neutral';

            // Mention / Bài viết trực tuyến (không có chấm điểm sao)
            if (r.rating == null) {
              if (sentiment === 'positive') {
                return 'Kính gửi quý cơ quan báo chí / bạn đọc ' + author + ', ' + bName + ' chân thành cảm ơn bài viết và sự quan tâm, đánh giá tích cực dành cho sản phẩm/dịch vụ của chúng tôi. Chúng tôi cam kết luôn mang đến trải nghiệm công nghệ chính hãng và dịch vụ chu đáo nhất!';
              }
              return 'Kính gửi quý độc giả, ' + bName + ' đã tiếp nhận phản ánh từ bài viết. Chúng tôi đang phối hợp với các bộ phận liên quan để kiểm tra và xử lý thỏa đáng. Kính mời liên hệ hotline ' + bHotline + ' để được hỗ trợ trực tiếp.';
            }

            if (!hasText) {
              if (r.rating >= 4) {
                return 'Kính gửi quý khách, ' + bName + ' chân thành cảm ơn quý khách đã tin chọn sản phẩm và đánh giá ' + r.rating + ' sao. Đội ngũ tư vấn và chăm sóc khách hàng luôn sẵn sàng đồng hành cùng quý khách!';
              }
              return 'Kính gửi quý khách, ' + bName + ' cảm ơn quý khách đã mua sắm. Chúng tôi rất tiếc khi trải nghiệm đơn hàng chưa đạt kỳ vọng. Kính mong quý khách liên hệ hotline ' + bHotline + ' để bộ phận CSKH hỗ trợ kịp thời.';
            }
            if (r.rating != null && r.rating <= 2) {
              const policyPromise = bConfig.policyPromise || 'chính sách hỗ trợ theo quy định';
              const slaResolution = bConfig.slaResolution || 'kịp thời';
              return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành xin lỗi về sự cố đối với sản phẩm/đơn hàng của quý khách. Chúng tôi đã chuyển thông tin tới ' + (r.suggestedDept || 'Trung tâm Bảo hành & CSKH') + ' để kiểm tra và áp dụng ' + policyPromise + '. Kính mời quý khách gọi hotline ' + bHotline + ' để được xử lý ' + slaResolution + '.';
            }
            return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành cảm ơn quý khách đã đánh giá tích cực. Chúng tôi cam kết luôn cung cấp sản phẩm chính hãng và dịch vụ hậu mãi chu đáo nhất cho quý khách!';
          }
        }
      };

      function getIndustryPack(indId) {
        if (INDUSTRY_PACKS[indId]) return INDUSTRY_PACKS[indId];
        const norm = stripAccents(indId || '');
        if (norm.includes('nha hang') || norm.includes('f&b') || norm.includes('am thuc') || norm.includes('quan an') || norm.includes('lau') || norm.includes('cafe')) return INDUSTRY_PACKS.f_and_b;
        if (norm.includes('ban le') || norm.includes('retail') || norm.includes('cua hang') || norm.includes('thuong mai') || norm.includes('e-com') || norm.includes('shop')) return INDUSTRY_PACKS.retail_ecommerce;
        if (norm.includes('tham my') || norm.includes('clinic') || norm.includes('spa') || norm.includes('y te') || norm.includes('benh vien') || norm.includes('bac si') || norm.includes('phong kham')) return INDUSTRY_PACKS.aesthetic_clinic;
        return INDUSTRY_PACKS.generic;
      }

      function getBrandConfig(brandId) {
        let b = null;
        try {
          const cfgObj = typeof D.config === 'string' ? JSON.parse(D.config) : D.config;
          b = (cfgObj.brands || []).find(x => x.id === brandId);
        } catch (e) { }
        if (!b && window.S && window.S.cfg && window.S.cfg.brands) {
          b = window.S.cfg.brands.find(x => x.id === brandId);
        }
        return b || { id: brandId, name: brandId, industry: 'generic', unitType: 'đơn vị', hotline: 'hotline CSKH', staff: [] };
      }
      window.stripAccents = stripAccents;
      window.matchWords = matchWords;
      window.matchRegion = matchRegion;
      window.INDUSTRY_PACKS = INDUSTRY_PACKS;
      window.getIndustryPack = getIndustryPack;
      window.getBrandConfig = getBrandConfig;

