rách nhiệm!", "date": "2026-10-11T09:15:00Z", "analysis": {"sentiment": "negative", "score": -1, "topics": ["warranty_return", "staff_service"], "severity": 1}}, {"id": "tz-2", "brandId": "techzone-store", "branch": "TechZone - Kênh Online E-com", "author": "Đỗ Thùy Trang", "rating": 1, "text": "Giao hàng trễ 5 ngày so với cam kết, hộp sản phẩm bị móp méo bể góc.", "date": "2026-10-07T14:20:00Z", "analysis": {"sentiment": "negative", "score": -1, "topics": ["shipping_delivery"], "severity": 1}}, {"id": "tz-3", "brandId": "techzone-store", "branch": "TechZone - Flagship Hai Bà Trưng (Q.1)", "author": "Lê Minh Quân", "rating": 5, "text": "Sản phẩm chính hãng nguyên seal, dùng rất mượt và ưng ý.", "date": "2026-10-13T16:00:00Z", "analysis": {"sentiment": "positive", "score": 1, "topics": ["product_quality"], "severity": 0}}, {"id": "tz-4", "brandId": "techzone-store", "branch": "TechZone - Thái Hà (Hà Nội)", "author": "Trần Quỳnh Nga", "rating": 5, "text": "Nhân viên kỹ thuật tư vấn rất am hiểu, hướng dẫn cài đặt tận tình chu đáo.", "date": "2026-10-12T10:45:00Z", "analysis": {"sentiment": "positive", "score": 1, "topics": ["staff_service"], "severity": 0}}, {"id": "tz-5", "brandId": "techzone-store", "branch": "TechZone - Kênh Online E-com", "author": "Hoàng Anh Tuấn", "rating": 5, "text": "Giao hàng hỏa tốc trong 2 giờ, đóng gói cẩn thận 3 lớp bóng khí.", "date": "2026-10-10T11:30:00Z", "analysis": {"sentiment": "positive", "score": 1, "topics": ["shipping_delivery"], "severity": 0}}, {"id": "tz-6", "brandId": "techzone-store", "branch": "TechZone - Flagship Hai Bà Trưng (Q.1)", "author": "Ngô Kiến Huy", "rating": 5, "text": "", "date": "2026-10-09T08:00:00Z", "analysis": {"sentiment": "positive", "score": 1, "topics": [], "severity": 0}}, {"id": "tz-m1", "brandId": "techzone-store", "branch": "TechZone - Thái Hà (Hà Nội)", "author": "GenK Công Nghệ", "rating": null, "channel": "Báo chí công nghệ", "source": "google_news", "text": "Trải nghiệm không gian mua sắm thiết bị thông minh mới của TechZone tại phố Thái Hà.", "date": "2026-10-12T07:00:00Z", "analysis": {"sentiment": "positive", "score": 1, "topics": ["store_facility"], "severity": 0}, "ticketStatus": "resolved", "url": "https://genk.vn/trai-nghiem-khong-gian-mua-sam-thiet-bi-cong-nghe-tai-techzone-20261014.chn"}]}}}</script>
  <script>
    (function () {
      var D = JSON.parse(document.getElementById('demo-data').textContent);
      window.__DEMO_D = D;


      /* =========================================================================
         KIẾN TRÚC 3 LỚP (THREE-LAYER ARCHITECTURE)
         Lớp 1: Lõi chung (Core Layer) - Thu thập, lọc, bằng chứng, vụ việc, thông báo, báo cáo
         Lớp 2: Bộ cấu hình ngành (Industry Configuration Packs) - Chủ đề, từ điển, rủi ro, mẫu phản hồi, phân tuyến
         Lớp 3: Cấu hình doanh nghiệp (Enterprise Configuration) - Thương hiệu, đơn vị, nhân sự, SLA, liên hệ, tone
         ========================================================================= */

      function stripAccents(str) {
        return (str || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/đ/gi, 'd')
          .toLowerCase();
      }

      function matchWords(text, words) {
        if (!text) return false;
        const pat1 = '(^|[^\\p{L}])(' + words.join('|') + ')([^\\p{L}]|$)';
        if (new RegExp(pat1, 'iu').test(text)) return true;
        const normText = stripAccents(text);
        const normWords = words.map(w => stripAccents(w));
        const pat2 = '(^|[^a-z0-9])(' + normWords.join('|') + ')([^a-z0-9]|$)';
        return new RegExp(pat2, 'i').test(normText);
      }

      function matchRegion(branchName, regionName, unitObj) {
        if (!regionName || regionName === 'all') return true;
        if (unitObj) {
          if (unitObj.regionId && unitObj.regionId === regionName) return true;
          if (unitObj.unitId && unitObj.unitId === regionName) return true;
          if (unitObj.regionToken && unitObj.regionToken === regionName) return true;
        }
        if (!branchName) return false;
        if (branchName === regionName || branchName.includes(regionName)) return true;
        const normBranch = stripAccents(branchName).toLowerCase().replace(/\s+/g, '');
        const normReg = stripAccents(regionName).toLowerCase().replace(/\s+/g, '');
        if (normBranch.includes(normReg)) return true;
        const qBranch = normBranch.replace(/quan(\d+)/g, 'q.$1').replace(/q(\d+)/g, 'q.$1');
        const qReg = normReg.replace(/quan(\d+)/g, 'q.$1').replace(/q(\d+)/g, 'q.$1');
        if (qBranch.includes(qReg)) return true;
        const m = branchName.match(/\(([^)]+)\)/);
        if (m) {
          const token = stripAccents(m[1]).toLowerCase().replace(/\s+/g, '').replace(/quan(\d+)/g, 'q.$1').replace(/q(\d+)/g, 'q.$1');
          if (token === qReg) return true;
        }
        return false;
      }

      const INDUSTRY_PACKS = {
        generic: {
          id: 'generic',
          name: 'Doanh nghiệp & Dịch vụ Chung / Đa ngành',
          defaultUnitType: 'đơn vị',
          topics: {
            service_quality: 'Chất lượng sản phẩm / dịch vụ',
            staff_attitude: 'Thái độ phục vụ / nhân viên',
            pricing_policy: 'Chi phí / chính sách giá',
            customer_support: 'Hỗ trợ khách hàng / xử lý yêu cầu',
            speed_timing: 'Thời gian đáp ứng / tiến độ',
            facility_infra: 'Cơ sở vật chất / hạ tầng'
          },
          positiveMatchers: [
            {
              id: 'service_quality',
              icon: '⭐',
              label: 'chất lượng dịch vụ, sản phẩm tốt',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('service_quality')) return true;
                return matchWords(r.text, ['chất lượng', 'tốt', 'hài lòng', 'ưng ý', 'chuẩn', 'chuyên nghiệp', 'tuyệt vời', 'đáng tin cậy']);
              }
            },
            {
              id: 'staff_attitude',
              icon: '👥',
              label: 'nhân sự nhiệt tình, chu đáo',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('staff_attitude')) return true;
                return matchWords(r.text, ['nhiệt tình', 'chu đáo', 'thân thiện', 'tận tâm', 'lễ phép', 'hỗ trợ', 'tư vấn tốt']);
              }
            },
            {
              id: 'speed_timing',
              icon: '⚡',
              label: 'xử lý nhanh chóng, đúng tiến độ',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('speed_timing')) return true;
                return matchWords(r.text, ['nhanh', 'nhanh chóng', 'đúng hẹn', 'kịp thời', 'ngay lập tức', 'tiến độ']);
              }
            },
            {
              id: 'pricing_policy',
              icon: '💰',
              label: 'chi phí hợp lý, minh bạch',
              test: (r) => {
                const t = r.analysis?.topics || [];
                if (t.includes('pricing_policy')) return true;
                return matchWords(r.text, ['hợp lý', 'giá tốt', 'đáng tiền', 'minh bạch', 'phải chăng', 'rõ ràng']);
