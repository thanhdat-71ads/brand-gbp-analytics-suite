              label: 'phản ánh về chi phí, phụ thu hoặc thanh toán chưa rõ ràng',
              match: (r) => matchWords(r.text, ['đắt', 'mập mờ', 'phụ thu', 'sai giá', 'hóa đơn', 'tính nhầm', 'không minh bạch'])
            }
          ],
          getRoutingDept: (topics = [], text = '', bConfig) => {
            if (topics.includes('service_quality') || matchWords(text, ['chất lượng', 'lỗi', 'kém'])) {
              return 'Ban Quản trị Chất lượng & Nghiệp vụ';
            }
            if (topics.includes('pricing_policy') || matchWords(text, ['chi phí', 'giá', 'hóa đơn', 'thanh toán'])) {
              return 'Bộ phận Tài chính & Thu ngân';
            }
            if (topics.includes('speed_timing') || matchWords(text, ['chậm', 'tiến độ', 'trễ'])) {
              return 'Bộ phận Điều phối & Vận hành';
            }
            return 'Phòng Chăm sóc Khách hàng (CSKH)';
          },
          getDraftReply: (r, bConfig) => {
            const bName = bConfig.name;
            const bHotline = bConfig.hotline || 'hotline hỗ trợ';
            const author = r.author || '';
            const hasText = (r.text || '').trim().length > 0;
            const sentiment = r.analysis?.sentiment || 'neutral';

            // Mention / Bài viết trực tuyến (không có chấm điểm sao)
            if (r.rating == null) {
              if (sentiment === 'positive') {
                return 'Kính gửi quý cơ quan báo chí / bạn đọc ' + author + ', ' + bName + ' chân thành cảm ơn bài viết và sự quan tâm, đánh giá tích cực dành cho thương hiệu của chúng tôi. Chúng tôi luôn cam kết duy trì chất lượng dịch vụ và minh bạch thông tin tới cộng đồng.';
              }
              return 'Kính gửi quý bạn đọc và khách hàng, ' + bName + ' đã tiếp nhận thông tin phản ánh từ bài viết. Chúng tôi đang phối hợp với các bộ phận chức năng để kiểm tra và xử lý thỏa đáng theo đúng quy trình. Mọi thông tin cần phối hợp xin liên hệ hotline: ' + bHotline + '.';
            }

            // Review có số sao (1-5★)
            if (!hasText) {
              if (r.rating >= 4) {
                return 'Kính gửi quý khách, ' + bName + ' chân thành cảm ơn quý khách đã tin tưởng và gửi đánh giá ' + r.rating + ' sao. Chúng tôi luôn sẵn sàng hỗ trợ và phục vụ quý khách chu đáo nhất!';
              }
              return 'Kính gửi quý khách, ' + bName + ' chân thành cảm ơn quý khách đã gửi đánh giá. Chúng tôi rất tiếc khi trải nghiệm chưa đạt kỳ vọng của quý khách. Kính mong quý khách liên hệ hotline ' + bHotline + ' để bộ phận CSKH có cơ hội lắng nghe và hỗ trợ kịp thời.';
            }

            if (r.rating != null && r.rating <= 2) {
              return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành xin lỗi về sự bất tiện quý khách đã gặp phải. Chúng tôi đã chuyển thông tin tới ' + (r.suggestedDept || 'Bộ phận Quản lý & CSKH') + ' để rà soát quy trình và có giải pháp hỗ trợ thỏa đáng. Kính mời quý khách liên hệ hotline ' + bHotline + ' để được giải quyết trực tiếp.';
            }

            return 'Kính gửi quý khách ' + author + ', ' + bName + ' chân thành cảm ơn quý khách đã tin chọn và đánh giá tích cực. Sự hài lòng của quý khách là động lực lớn nhất để tập thể chúng tôi tiếp tục nâng cao chất lượng dịch vụ!';
          }
        },

