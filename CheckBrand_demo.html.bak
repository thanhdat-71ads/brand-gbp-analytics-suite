<!doctype html>
<html lang="vi" data-theme="dark">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CheckBrand – Bản demo</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap">


  <style>
    :root {
      --bg: #f4f5f9;
      --surface-1: #ffffff;
      --surface-2: #f0f1f6;
      --line: #e3e5ee;
      --text-primary: #12141f;
      --text-secondary: #4b5066;
      --text-muted: #7a8097;
      --accent: #b8860b;
      --accent-soft: #fdf3d6;
      --series-1: #2a78d6;
      --series-2: #eb6834;
      --series-3: #1baf7a;
      --good: #0ca30c;
      --neutral: #9aa0b4;
      --bad: #d03b3b;
      --warn: #fab219;
      --serious: #ec835a;
      --seq-1: #cde2fb;
      --seq-2: #86b6ef;
      --seq-3: #3987e5;
      --seq-4: #1c5cab;
      --shadow: 0 1px 2px rgba(15, 20, 40, .06);
      color-scheme: light;
    }

    :root[data-theme="dark"] {
      --bg: #0f1220;
      --surface-1: #171a2b;
      --surface-2: #1e2236;
      --line: #272b42;
      --text-primary: #eceef7;
      --text-secondary: #b4b9d0;
      --text-muted: #838aa6;
      --accent: #f2b84b;
      --accent-soft: #3a2f14;
      --series-1: #3987e5;
      --series-2: #d95926;
      --series-3: #199e70;
      --neutral: #7c8299;
      --bad: #e66767;
      --serious: #ec835a;
      --seq-1: #1d3558;
      --seq-2: #1c5cab;
      --seq-3: #3987e5;
      --seq-4: #86b6ef;
      --shadow: none;
      color-scheme: dark;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]):not([data-theme="dark"]) {
        color-scheme: dark
      }
    }

    * {
      box-sizing: border-box
    }

    html,
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text-primary);
      font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif
    }

    button {
      font: inherit;
      color: inherit;
      cursor: pointer
    }

    a {
      color: var(--series-1)
    }

    #app {
      display: grid;
      grid-template-columns: 248px 1fr;
      min-height: 100vh
    }

    #side {
      background: var(--surface-1);
      border-right: 1px solid var(--line);
      padding: 14px 10px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: auto;
      display: flex;
      flex-direction: column;
      gap: 6px
    }

    #main {
      padding: 22px 28px 60px;
      min-width: 0;
      max-width: 1280px
    }

    .brandbox {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 6px 10px
    }

    .logo {
      width: 34px;
      height: 34px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px
    }

    .logo i {
      background: #e11d74;
      border-radius: 3px
    }

    .logo i:nth-child(2),
    .logo i:nth-child(3) {
      opacity: .6
    }

    .brandbox b {
      display: block;
      font-size: 15px
    }

    select.brandsel {
      width: 100%;
      background: var(--surface-2);
      border: 1px solid var(--line);
      color: var(--text-primary);
      border-radius: 8px;
      padding: 7px 8px;
      margin-bottom: 6px
    }

    .grp {
      font-size: 11px;
      letter-spacing: .08em;
      color: var(--text-muted);
      padding: 12px 8px 4px;
      text-transform: uppercase
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 9px;
      width: 100%;
      text-align: left;
      background: none;
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 7px 9px;
      color: var(--text-secondary)
    }

    .nav:hover {
      background: var(--surface-2)
    }

    .nav.on {
      background: var(--surface-2);
      border-color: var(--series-1);
      color: var(--text-primary)
    }

    .nav .ic {
      width: 16px;
      text-align: center
    }

    .badge {
      margin-left: auto;
      background: var(--bad);
      color: #fff;
      border-radius: 10px;
      font-size: 11px;
      padding: 0 6px;
      line-height: 17px
    }

    .healthcard {
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px;
      margin-top: 8px
    }

    .healthcard .t {
      font-size: 11px;
      letter-spacing: .08em;
      color: var(--text-muted);
      text-transform: uppercase
    }

    .row {
      display: flex;
      align-items: center;
      gap: 10px
    }

    .live {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-muted);
      padding: 8px 6px 0
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--good);
      display: inline-block
    }

    .dot.off {
      background: var(--neutral)
    }

    .sidefoot {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 6px
    }

    .btn {
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 6px 12px
    }

    .btn:hover {
      border-color: var(--series-1)
    }

    .btn.primary {
      background: var(--series-1);
      border-color: var(--series-1);
      color: #fff
    }

    .btn.on {
      background: var(--accent-soft);
      border-color: var(--accent);
      color: var(--accent)
    }

    .btn:disabled {
      opacity: .5;
      cursor: wait
    }

    h1 {
      font-size: 22px;
      margin: 0
    }

    .sub {
      color: var(--text-secondary);
      margin: 2px 0 0
    }

    .muted {
      color: var(--text-muted)
    }

    .head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap
    }

    .banner {
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      color: var(--text-primary);
      border-radius: 10px;
      padding: 8px 12px;
      margin-bottom: 14px;
      font-size: 13px
    }

    .banner.crit {
      background: rgba(208, 59, 59, .12);
      border-color: var(--bad)
    }

    .grid {
      display: grid;
      gap: 14px
    }

    .g4 {
      grid-template-columns: repeat(4, minmax(0, 1fr))
    }

    .g3 {
      grid-template-columns: repeat(3, minmax(0, 1fr))
    }

    .g2 {
      grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .g21 {
      grid-template-columns: 2fr 1fr
    }

    @media(max-width:1000px) {

      .g4,
      .g3,
      .g2,
      .g21 {
        grid-template-columns: 1fr 1fr
      }
    }

    @media(max-width:700px) {
      #app {
        grid-template-columns: 1fr
      }

      #side {
        position: static;
        height: auto
      }

      .g4,
      .g3,
      .g2,
      .g21 {
        grid-template-columns: 1fr
      }
    }

    .card {
      background: var(--surface-1);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px 16px;
      box-shadow: var(--shadow);
      margin-bottom: 14px;
      min-width: 0
    }

    .grid .card {
      margin-bottom: 0
    }

    .card h3 {
      margin: 0 0 10px;
      font-size: 12px;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 600
    }

    .kpi .v {
      font-size: 30px;
      font-weight: 650;
      line-height: 1.15
    }

    .kpi .d {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px
    }

    .up {
      color: var(--good)
    }

    .down {
      color: var(--bad)
    }

    .star {
      color: #f2b84b
    }

    table {
      width: 100%;
      border-collapse: collapse
    }

    th {
      font-size: 11px;
      letter-spacing: .05em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-align: left;
      font-weight: 600
    }

    th,
    td {
      padding: 7px 8px;
      border-bottom: 1px solid var(--line);
      vertical-align: top
    }

    tr:last-child td {
      border-bottom: 0
    }

    td.num,
    th.num {
      text-align: right;
      font-variant-numeric: tabular-nums
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      padding: 1px 8px;
      border-radius: 999px;
      border: 1px solid var(--line);
      color: var(--text-secondary);
      background: var(--surface-2);
      white-space: nowrap
    }

    .chip.pos {
      color: var(--good);
      border-color: var(--good)
    }

    .chip.neg {
      color: var(--bad);
      border-color: var(--bad)
    }

    .chip.neu {
      color: var(--text-secondary)
    }

    .chip.mock {
      color: var(--accent);
      border-color: var(--accent);
      background: var(--accent-soft)
    }

    .legend {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--text-secondary);
      margin: 6px 0 0
    }

    .legend i {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      margin-right: 5px;
      vertical-align: -1px
    }

    .bars {
      display: flex;
      flex-direction: column;
      gap: 8px
    }

    .bar {
      display: grid;
      grid-template-columns: minmax(120px, 190px) 1fr 70px;
      gap: 10px;
      align-items: center
    }

    .bar .tr {
      height: 10px;
      background: var(--surface-2);
      border-radius: 5px;
      overflow: hidden;
      display: flex
    }

    .bar .tr i {
      display: block;
      height: 100%;
      border-right: 2px solid var(--surface-1)
    }

    .bar .tr i:last-child {
      border-right: 0
    }

    svg text {
      fill: var(--text-muted);
      font-size: 9.5px
    }

    .scroll {
      max-height: 420px;
      overflow: auto
    }

    svg .grid line {
      stroke: var(--line)
    }

    .tabs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap
    }

    .starbtn {
      min-width: 46px
    }

    .rev {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 6px 16px
    }

    .rev:last-child {
      border-bottom: 0
    }

    .rev .who {
      font-weight: 600
    }

    .rev .txt {
      color: var(--text-secondary);
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
      cursor: pointer
    }

    .rev .txt.open {
      -webkit-line-clamp: unset
    }

    .rev .meta {
      font-size: 12px;
      color: var(--text-muted)
    }

    .rev .side {
      text-align: right
    }

    .acc {
      border: 1px solid var(--line);
      border-radius: 10px;
      margin-bottom: 8px;
      background: var(--surface-2)
    }

    .acc button {
      all: unset;
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      cursor: pointer
    }

    .acc button:hover {
      background: rgba(127, 127, 127, .08)
    }

    .acc.on {
      border-color: var(--series-1)
    }

    .empty {
      padding: 28px;
      text-align: center;
      color: var(--text-muted)
    }

    .sev {
      display: inline-block;
      padding: 0 6px;
      border-radius: 4px;
      font-size: 11px;
      color: #fff
    }

    .sev.s2 {
      background: var(--serious);
      color: #2a1206
    }

    .sev.s3 {
      background: var(--bad)
    }

    .alert {
      display: grid;
      grid-template-columns: 24px 1fr auto;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid var(--line)
    }

    .alert.unread .t {
      font-weight: 650
    }

    .keywords {
      display: flex;
      gap: 8px;
      flex-wrap: wrap
    }

    .kw {
      border: 1px solid var(--line);
      background: var(--surface-2);
      border-radius: 8px;
      padding: 3px 9px;
      font-size: 13px
    }

    .kw b {
      color: var(--text-muted);
      font-weight: 500;
      margin-left: 6px;
      font-size: 12px
    }

    .kw.neg {
      border-color: var(--bad)
    }

    #tip {
      position: fixed;
      pointer-events: none;
      background: #0b0d17;
      color: #fff;
      border: 1px solid #2b3050;
      border-radius: 8px;
      padding: 6px 9px;
      font-size: 12px;
      z-index: 50;
      display: none;
      max-width: 260px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .35)
    }

    #toasts {
      position: fixed;
      right: 16px;
      bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 60
    }

    .toast {
      background: var(--surface-1);
      border: 1px solid var(--bad);
      border-left-width: 4px;
      border-radius: 8px;
      padding: 9px 12px;
      max-width: 340px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, .3)
    }

    .loading {
      padding: 60px;
      text-align: center;
      color: var(--text-muted)
    }

    .hide {
      display: none
    }

    /* =====================================================================
   CheckBrand – Google Maps / Material style theme (lớp ghi đè)
   ---------------------------------------------------------------------
   Nạp SAU app.css trong index.html. Không cần sửa app.css.
   Muốn quay lại giao diện cũ: xóa dòng link file này trong index.html.
   ===================================================================== */

    /* ---------- 1. BẢNG MÀU (Light) – theo bảng màu Google ---------- */
    :root {
      --font-ui: "Roboto", system-ui, -apple-system, "Segoe UI", sans-serif;

      --bg: #f8f9fa;
      /* nền trang */
      --surface-1: #ffffff;
      /* thẻ (card) */
      --surface-2: #f1f3f4;
      /* nền phụ, hover */
      --line: #dadce0;
      /* đường kẻ */
      --text-primary: #202124;
      /* chữ chính */
      --text-secondary: #5f6368;
      /* chữ phụ */
      --text-muted: #80868b;
      /* chữ mờ */

      --accent: #fbbc04;
      /* vàng sao Google Maps */
      --accent-soft: #fef7e0;
      --accent-text: #b06000;
      /* chữ trên nền vàng nhạt (vàng sao quá sáng để làm chữ) */
      --gblue: #1a73e8;
      /* xanh Google – nút, link, mục đang chọn */
      --gblue-soft: #e8f0fe;

      --series-1: #1a73e8;
      --good: #188038;
      --bad: #d93025;
      --warn: #f9ab00;

      --radius-card: 12px;
      --radius-chip: 8px;
      --shadow: 0 1px 2px rgba(60, 64, 67, .15), 0 1px 3px 1px rgba(60, 64, 67, .08);
    }

    /* ---------- 2. BẢNG MÀU (Dark) – theo Google Maps dark ---------- */
    :root[data-theme="dark"] {
      --bg: #1f1f1f;
      --surface-1: #28292a;
      --surface-2: #303134;
      --line: #3c4043;
      --text-primary: #e8eaed;
      --text-secondary: #bdc1c6;
      --text-muted: #9aa0a6;
      --accent: #fdd663;
      --accent-soft: #3d3420;
      --accent-text: #fdd663;
      --gblue: #8ab4f8;
      --gblue-soft: #2c3a52;
      --series-1: #8ab4f8;
      --good: #81c995;
      --bad: #f28b82;
      --shadow: none;
    }

    /* ---------- 3. FONT ---------- */
    html,
    body {
      font-family: var(--font-ui);
      font-size: 14px;
      line-height: 1.5;
      letter-spacing: .01em;
      -webkit-font-smoothing: antialiased;
    }

    button,
    input,
    select,
    textarea {
      font-family: inherit;
    }

    /* Số liệu thẳng cột trong bảng & KPI */
    td,
    th,
    .kpi .v,
    .num,
    .star {
      font-variant-numeric: tabular-nums;
    }

    /* ---------- 4. TIÊU ĐỀ: bỏ VIẾT HOA, dùng sentence case như Google ---------- */
    h1 {
      font-size: 22px;
      font-weight: 500;
      letter-spacing: 0;
    }

    .card h3,
    .grp,
    .healthcard .t,
    th {
      text-transform: none;
      letter-spacing: .01em;
    }

    .card h3 {
      font-size: 15px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .grp {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    th {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      white-space: nowrap;
    }

    /* ---------- 5. THẺ (CARD) ---------- */
    /* Không đổ bóng khi hover: card không bấm được, bóng sẽ gây hiểu nhầm */
    .card {
      border-radius: var(--radius-card);
      border: 1px solid var(--line);
      box-shadow: none;
      overflow-x: auto;
      /* bảng rộng (tiêu đề cột không xuống dòng) cuộn ngang trong card thay vì tràn trang */
    }

    /* ---------- 6. MENU TRÁI – kiểu "viên thuốc" của Google ---------- */
    .nav {
      border: 0;
      border-radius: 999px;
      padding: 8px 14px;
      color: var(--text-secondary);
    }

    .nav:hover {
      background: var(--surface-2);
    }

    .nav.on {
      background: var(--gblue-soft);
      color: var(--gblue);
      font-weight: 500;
      border: 0;
    }

    /* ---------- 7. NÚT ---------- */
    .btn {
      border-radius: 999px;
      padding: 7px 16px;
      font-weight: 500;
    }

    .btn:hover {
      border-color: var(--gblue);
    }

    .btn.primary {
      background: var(--gblue);
      border-color: var(--gblue);
      color: #fff;
    }

    :root[data-theme="dark"] .btn.primary {
      color: #202124;
    }

    /* Nút đang chọn (7/30/90 ngày, lọc sao): xanh thay vì vàng để đủ tương phản */
    .btn.on {
      background: var(--gblue-soft);
      border-color: var(--gblue);
      color: var(--gblue);
    }

    /* ---------- 8. CHIP (nhãn chủ đề, cảm xúc, lọc sao) ---------- */
    .chip,
    .starbtn {
      border-radius: var(--radius-chip);
      font-weight: 500;
    }

    .chip.neg {
      background: #fce8e6;
      color: #c5221f;
    }

    .chip.pos {
      background: #e6f4ea;
      color: #137333;
    }

    .chip.neu {
      background: var(--surface-2);
      color: var(--text-secondary);
    }

    .chip.mock {
      color: var(--accent-text);
    }

    .banner {
      border-color: var(--accent);
    }

    :root[data-theme="dark"] .chip.neg {
      background: #5c2b29;
      color: #f28b82;
    }

    :root[data-theme="dark"] .chip.pos {
      background: #264d34;
      color: #81c995;
    }

    /* ---------- 9. SAO ĐÁNH GIÁ – vàng Google Maps ---------- */
    .star {
      color: var(--accent);
    }

    /* ---------- 10. BẢNG ---------- */
    th,
    td {
      padding: 10px 12px;
    }

    td.num,
    th.num {
      text-align: right;
    }

    tr:hover td {
      background: var(--surface-2);
    }

    /* ---------- 11. LINK ---------- */
    a {
      color: var(--gblue);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    /* =====================================================================
   GIAI ĐOẠN 2 – Google Review kiểu Google Maps
   ===================================================================== */

    /* Khối tổng hợp rating: điểm lớn bên trái, 5 thanh sao bên phải (bấm để lọc) */
    .rating-summary {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 28px;
      align-items: center;
    }

    .rating-summary .rs-score {
      text-align: center;
      min-width: 110px;
    }

    .rating-summary .big {
      font-size: 44px;
      line-height: 1.1;
      font-weight: 400;
      color: var(--text-primary);
    }

    .rating-summary .cnt {
      color: var(--text-secondary);
      font-size: 13px;
    }

    .rbars {
      display: flex;
      flex-direction: column;
      gap: 2px;
      max-width: 520px;
    }

    .rbar {
      display: grid;
      grid-template-columns: 12px 1fr 48px;
      gap: 10px;
      align-items: center;
      width: 100%;
      padding: 3px 6px;
      border: 0;
      border-radius: 6px;
      background: none;
      color: var(--text-secondary);
      text-align: left;
    }

    .rbar:hover {
      background: var(--surface-2);
    }

    .rbar .track {
      display: block;
      height: 8px;
      border-radius: 999px;
      background: var(--surface-2);
      overflow: hidden;
    }

    .rbar:hover .track {
      background: var(--line);
    }

    .rbar .fill {
      display: block;
      height: 100%;
      border-radius: 999px;
      background: var(--accent);
    }

    .rbar .num {
      text-align: right;
    }

    .rbar.on {
      background: var(--gblue-soft);
      color: var(--gblue);
      font-weight: 500;
    }

    .rbar:focus-visible {
      outline: 2px solid var(--gblue);
      outline-offset: 1px;
    }

    @media (max-width: 520px) {
      .rating-summary {
        grid-template-columns: 1fr;
        gap: 12px;
      }
    }

    /* Thẻ review: avatar + tên, dòng sao · ngày · chi nhánh, nội dung cắt 3 dòng */
    .rev {
      display: block;
      padding: 16px 0;
    }

    .rev-head {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #fff;
      font-weight: 500;
      font-size: 16px;
      flex: none;
    }

    .rev .who {
      font-weight: 500;
      color: var(--text-primary);
    }

    .rev .meta {
      font-size: 13px;
      color: var(--text-secondary);
    }

    .rev-body {
      margin: 8px 0 0 52px;
    }

    .rev .txt {
      color: var(--text-primary);
      -webkit-line-clamp: 3;
      cursor: auto;
    }

    .rev .txt.muted {
      color: var(--text-muted);
      font-style: italic;
    }

    .more-btn {
      border: 0;
      background: none;
      padding: 2px 0;
      margin-top: 2px;
      color: var(--gblue);
      font-weight: 500;
      font-size: 13px;
    }

    .more-btn:hover {
      text-decoration: underline;
    }

    .more-btn[hidden] {
      display: none;
    }

    .rev-chips {
      margin-top: 8px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .rev-foot {
      margin-top: 8px;
      text-align: right;
      font-size: 13px;
    }

    @media (max-width: 520px) {
      .rev-body {
        margin-left: 0;
      }
    }

    /* Phản hồi của chủ sở hữu + nhãn "Chưa phản hồi" cho review 1–3★ */
    .owner-reply {
      margin-top: 10px;
      padding-left: 12px;
      border-left: 2px solid var(--line);
    }

    .owner-reply .meta b {
      font-weight: 500;
      color: var(--text-primary);
    }

    .owner-reply .txt {
      color: var(--text-secondary);
    }

    .chip.noreply {
      background: #fce8e6;
      color: #c5221f;
      border-color: transparent;
    }

    :root[data-theme="dark"] .chip.noreply {
      background: #5c2b29;
      color: #f28b82;
    }

    /* =====================================================================
   GIAI ĐOẠN 3 – Bảng so sánh đối thủ & nhật ký đồng bộ
   ===================================================================== */
    table.comp tr.me td {
      background: var(--gblue-soft);
    }

    table.comp tr.me td:first-child {
      font-weight: 500;
      color: var(--gblue);
    }

    .edot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 2px;
      margin-right: 6px;
    }

    .chg {
      font-size: 11px;
      margin-left: 4px;
      white-space: nowrap;
    }

    .negbad {
      background: #fce8e6;
      color: #c5221f;
      border-radius: 4px;
      padding: 1px 6px;
    }

    :root[data-theme="dark"] .negbad {
      background: #5c2b29;
      color: #f28b82;
    }

    .negmax {
      font-weight: 700;
    }

    /* Nhật ký đồng bộ: ghi chú 1 dòng (rê chuột xem đủ), dòng có lỗi viền trái đỏ */
    td.notes {
      max-width: 360px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    tr.err td:first-child {
      box-shadow: inset 3px 0 0 var(--bad);
    }

    /* =====================================================================
   CheckBrand – Chuông cảnh báo + toast (đi kèm notify.js)
   Dùng biến màu sẵn có của dashboard; tự hợp chế độ sáng / tối
   ===================================================================== */
    #cbn-root {
      --cbn-blue: var(--gblue, var(--series-1, #1a73e8));
      --cbn-red: var(--bad, #d93025);
      --cbn-star: var(--accent, #fbbc04);
      font-family: inherit;
    }

    /* Chừa chỗ cho chuông ở góc phải tiêu đề trang (chỉ tiêu đề trang, không đụng tiêu đề trong card) */
    #main>.head {
      padding-right: 64px;
    }

    /* ---------- Chuông ---------- */
    #cbn-bell {
      position: fixed;
      top: 14px;
      right: 20px;
      z-index: 1000;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--surface-1, #fff);
      color: var(--text-secondary, #5f6368);
      border: 1px solid var(--line, #dadce0);
      box-shadow: 0 1px 3px rgba(60, 64, 67, .2);
      cursor: pointer;
      transition: background .15s, color .15s;
    }

    #cbn-bell:hover {
      background: var(--surface-2, #f1f3f4);
    }

    #cbn-bell.has-unread {
      color: var(--cbn-red);
    }

    #cbn-bell:focus-visible {
      outline: 2px solid var(--cbn-blue);
      outline-offset: 2px;
    }

    #cbn-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      min-width: 20px;
      height: 20px;
      padding: 0 5px;
      border-radius: 10px;
      background: var(--cbn-red);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      line-height: 20px;
      text-align: center;
      border: 2px solid var(--surface-1, #fff);
      font-variant-numeric: tabular-nums;
    }

    #cbn-badge[hidden] {
      display: none;
    }

    /* Rung 3 nhịp */
    #cbn-bell.cbn-shake svg {
      animation: cbn-shake .9s ease-in-out;
      transform-origin: 50% 10%;
    }

    #cbn-bell.cbn-shake #cbn-badge {
      animation: cbn-pop .9s ease-out;
    }

    @keyframes cbn-shake {

      0%,
      100% {
        transform: rotate(0);
      }

      10% {
        transform: rotate(16deg);
      }

      20% {
        transform: rotate(-14deg);
      }

      30% {
        transform: rotate(12deg);
      }

      40% {
        transform: rotate(-10deg);
      }

      50% {
        transform: rotate(7deg);
      }

      60% {
        transform: rotate(-5deg);
      }

      70% {
        transform: rotate(3deg);
      }

      80% {
        transform: rotate(-2deg);
      }
    }

    @keyframes cbn-pop {
      0% {
        transform: scale(1);
      }

      15% {
        transform: scale(1.3);
      }

      30%,
      100% {
        transform: scale(1);
      }
    }

    /* ---------- Menu thả xuống ---------- */
    #cbn-panel {
      position: fixed;
      top: 66px;
      right: 20px;
      z-index: 1001;
      width: 360px;
      max-width: calc(100vw - 32px);
      max-height: min(520px, 75vh);
      display: flex;
      flex-direction: column;
      background: var(--surface-1, #fff);
      color: var(--text-primary, #202124);
      border: 1px solid var(--line, #dadce0);
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(60, 64, 67, .25);
      overflow: hidden;
    }

    #cbn-panel[hidden] {
      display: none;
    }

    .cbn-p-head,
    .cbn-p-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
    }

    .cbn-p-head {
      border-bottom: 1px solid var(--line, #dadce0);
    }

    .cbn-p-foot {
      border-top: 1px solid var(--line, #dadce0);
      font-size: 13px;
      color: var(--text-secondary, #5f6368);
      flex-wrap: wrap;
    }

    .cbn-p-foot label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    #cbn-list {
      overflow-y: auto;
    }

    .cbn-empty {
      padding: 28px 16px;
      text-align: center;
      color: var(--text-muted, #80868b);
    }

    .cbn-item {
      padding: 12px 16px;
      border-bottom: 1px solid var(--line, #dadce0);
      cursor: pointer;
    }

    .cbn-item:last-child {
      border-bottom: 0;
    }

    .cbn-item:hover {
      background: var(--surface-2, #f1f3f4);
    }

    .cbn-item.unread {
      box-shadow: inset 3px 0 0 var(--cbn-red);
      background: color-mix(in srgb, var(--cbn-red) 6%, transparent);
    }

    .cbn-i-top {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }

    .cbn-time {
      margin-left: auto;
      color: var(--text-muted, #80868b);
      white-space: nowrap;
    }

    .cbn-i-branch {
      font-size: 13px;
      font-weight: 500;
      margin-top: 4px;
    }

    .cbn-i-text {
      font-size: 13px;
      color: var(--text-secondary, #5f6368);
      margin-top: 2px;
    }

    .cbn-brand {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--text-secondary, #5f6368);
    }

    .cbn-brand i,
    .cbn-t-brand i {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      flex: none;
    }

    .cbn-stars {
      letter-spacing: 1px;
      font-size: 13px;
      white-space: nowrap;
    }

    .cbn-stars .on {
      color: var(--cbn-star);
    }

    .cbn-stars .off {
      color: var(--line, #dadce0);
    }

    .cbn-link {
      background: none;
      border: 0;
      padding: 4px 6px;
      border-radius: 6px;
      color: var(--cbn-blue);
      font: inherit;
      font-weight: 500;
      cursor: pointer;
    }

    .cbn-link:hover {
      background: var(--surface-2, #f1f3f4);
    }

    /* ---------- Toast ---------- */
    #cbn-toasts {
      position: fixed;
      top: 70px;
      right: 20px;
      z-index: 999;
      width: 360px;
      max-width: calc(100vw - 32px);
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .cbn-toast {
      pointer-events: auto;
      background: var(--surface-1, #fff);
      color: var(--text-primary, #202124);
      border: 1px solid var(--line, #dadce0);
      border-left: 4px solid var(--warn, #f9ab00);
      border-radius: 12px;
      padding: 12px 14px;
      box-shadow: 0 4px 16px rgba(60, 64, 67, .22);
      animation: cbn-in .3s cubic-bezier(.2, .8, .2, 1);
    }

    .cbn-toast.r1 {
      border-left-color: var(--cbn-red);
    }

    .cbn-toast.cbn-sum {
      border-left-color: var(--cbn-blue);
    }

    .cbn-toast.cbn-out {
      animation: cbn-out .25s ease-in forwards;
    }

    @keyframes cbn-in {
      from {
        opacity: 0;
        transform: translateX(40px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes cbn-out {
      to {
        opacity: 0;
        transform: translateX(40px);
      }
    }

    .cbn-t-top {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cbn-t-top b {
      font-size: 14px;
      font-weight: 500;
    }

    .cbn-x {
      margin-left: auto;
      background: none;
      border: 0;
      cursor: pointer;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      color: var(--text-muted, #80868b);
      font-size: 14px;
    }

    .cbn-x:hover {
      background: var(--surface-2, #f1f3f4);
    }

    .cbn-t-brand {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-secondary, #5f6368);
      margin-top: 4px;
    }

    .cbn-t-text {
      font-size: 13px;
      margin-top: 6px;
      line-height: 1.45;
    }

    .cbn-t-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 10px;
      font-size: 12px;
    }

    .cbn-muted {
      color: var(--text-muted, #80868b);
    }

    .cbn-view {
      border: 0;
      border-radius: 999px;
      padding: 6px 14px;
      cursor: pointer;
      background: var(--cbn-blue);
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 500;
    }

    :root[data-theme="dark"] .cbn-view {
      color: #202124;
    }

    /* Nháy sáng review được mở từ cảnh báo */
    .rev.cbn-flash {
      animation: cbn-flash 3s ease-out;
      border-radius: 8px;
    }

    @keyframes cbn-flash {

      0%,
      30% {
        box-shadow: 0 0 0 3px var(--cbn-blue);
        background: color-mix(in srgb, var(--cbn-blue) 10%, transparent);
      }

      100% {
        box-shadow: 0 0 0 0 transparent;
        background: transparent;
      }
    }

    /* Người dùng bật "giảm chuyển động" trong hệ điều hành: tắt rung */
    @media (prefers-reduced-motion: reduce) {

      #cbn-bell.cbn-shake svg,
      #cbn-bell.cbn-shake #cbn-badge,
      .cbn-toast,
      .cbn-toast.cbn-out,
      .rev.cbn-flash {
        animation: none;
      }
    }

    /* Điện thoại */
    @media (max-width: 600px) {
      #cbn-bell {
        top: 10px;
        right: 12px;
      }

      #cbn-panel,
      #cbn-toasts {
        right: 12px;
        left: 12px;
        width: auto;
      }
    }

    #demo-tag {
      position: fixed;
      right: 16px;
      bottom: 12px;
      z-index: 998;
      font-size: 12px;
      padding: 6px 12px;
      border-radius: 999px;
      background: var(--surface-1, #fff);
      color: var(--text-secondary, #5f6368);
      border: 1px solid var(--line, #dadce0);
      box-shadow: 0 1px 3px rgba(60, 64, 67, .2);
      pointer-events: none
    }

    /* =====================================================================
       Print Stylesheet (Bố cục in báo cáo chuẩn PDF)
       ===================================================================== */
    @media print {
      body.modal-open {
        background: #ffffff !important;
        color: #000000 !important;
        font-family: system-ui, -apple-system, Roboto, sans-serif !important;
        font-size: 11pt !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      body.modal-open #app,
      body.modal-open #side,
      body.modal-open #demo-tag,
      body.modal-open #tip,
      body.modal-open #toasts,
      body.modal-open #cbn-root,
      body.modal-open button {
        display: none !important;
      }

      body.modal-open #report-modal {
        position: static !important;
        display: block !important;
        background: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        height: auto !important;
      }

      body.modal-open #report-modal>.card {
        border: none !important;
        box-shadow: none !important;
        max-width: 100% !important;
        width: 100% !important;
        max-height: none !important;
        overflow: visible !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #ffffff !important;
        color: #000000 !important;
      }

      body.modal-open .grid.g4 {
        display: flex !important;
        flex-direction: row !important;
        gap: 12px !important;
        margin-bottom: 14px !important;
      }

      body.modal-open .grid.g4>.card.kpi {
        flex: 1 1 25% !important;
        border: 1px solid #dcdcdc !important;
        background: #fafafa !important;
        padding: 10px !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
      }

      body.modal-open .card {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
        border: 1px solid #e0e0e0 !important;
        background: #ffffff !important;
        color: #000000 !important;
        margin-bottom: 12px !important;
        padding: 12px !important;
      }

      body.modal-open .v {
        font-size: 16pt !important;
        font-weight: 700 !important;
        color: #000000 !important;
      }

      body.modal-open h2,
      body.modal-open h3 {
        color: #000000 !important;
        break-after: avoid !important;
        page-break-after: avoid !important;
      }

      body:not(.modal-open) #side,
      body:not(.modal-open) #demo-tag,
      body:not(.modal-open) #tip,
      body:not(.modal-open) #toasts,
      body:not(.modal-open) #cbn-root,
      body:not(.modal-open) .tabs,
      body:not(.modal-open) button {
        display: none !important;
      }

      body:not(.modal-open) #app {
        display: block !important;
      }
    }
  </style>
</head>

<body>
  <div id="app">
    <aside id="side"></aside>
    <main id="main">
      <div class="loading">Đang tải…</div>
    </main>
  </div>
  <div id="tip" role="tooltip"></div>
  <div id="toasts"></div>




  <div id="demo-tag">Bản demo · dữ liệu Google Review thật, chụp ngày 15/10/2026</div>
