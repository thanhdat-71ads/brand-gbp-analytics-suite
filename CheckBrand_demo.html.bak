          riskRules: [
            {
              id: 'service_quality',
              label: 'phản ánh chất lượng dịch vụ hoặc sản phẩm chưa đạt yêu cầu',
              match: (r) => matchWords(r.text, ['kém', 'lỗi', 'hỏng', 'dở', 'không đúng', 'thất vọng', 'tệ', 'kém chất lượng'])
            },
            {
              id: 'staff_attitude',
              label: 'phản ánh thái độ nhân viên chưa chuẩn mực hoặc thiếu hỗ trợ',
              match: (r) => matchWords(r.text, ['thái độ', 'khó chịu', 'cộc lốc', 'lơ là', 'vô trách nhiệm', 'bỏ bê', 'thiếu tôn trọng'])
            },
            {
              id: 'speed_timing',
              label: 'phản ánh chậm trễ hoặc thời gian xử lý kéo dài',
